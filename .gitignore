# Python bytecode / caches
__pycache__/
*.py[cod]

# Throwaway test certs + private keys, generated by the local stubs.
# Regenerate: python3 server/tls_stub.py (or ws_stub.py / match_stub.py)
# Then trust them: python3 tools/install_test_ca.py
server/.crucible-test-ca/

# Append-only runtime logs written by the local stubs. Regenerated per run;
# they are not evidence (captured findings live in snapshots/).
server/*.log

# Pak rebuild scratch
*.pak.new
